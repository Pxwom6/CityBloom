# Test builds (e2e, dev scripts) find the local relay here: npm run relay
VITE_RELAY_URL=ws://127.0.0.1:8787
# Peer-to-peer through Trystero (F2) can be tried against a Nostr relay on this computer
# (e2e/f2-trystero.spec.ts starts one; pages prefer it when localStorage citybloom.signal = trystero).
VITE_TRYSTERO_RELAYS=ws://127.0.0.1:7447
