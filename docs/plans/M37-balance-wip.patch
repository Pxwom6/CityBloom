+const FORCES: Record<string, { route: 'highway' | 'air' | 'sea'; units: UnitKind[] }> = {
+  robot: { route: 'highway', units: ['windupbot', ...Array<UnitKind>(6).fill('tank')] },
+  fortress: { route: 'air', units: ['skyfortress', ...Array<UnitKind>(6).fill('bomber')] },
