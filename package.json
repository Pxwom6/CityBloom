{
  "name": "citybloom",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:test": "vite build --mode test --outDir dist-test",
    "build:e2e": "vite build --mode test --base /Sim-Cities/ --outDir dist-e2e",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "npm run build:e2e && playwright test",
    "soak": "npm run build:e2e && SOAK=1 playwright test --grep @soak",
    "playthrough": "npm run build:e2e && PLAYTHROUGH=1 playwright test --grep @playthrough",
    "finale": "npm run build:e2e && PLAYTHROUGH=1 playwright test --grep @finale",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "bench": "tsx scripts/bench.ts",
    "balance": "tsx scripts/balance.ts"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "preact": "^10.29.8",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.20.4",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
