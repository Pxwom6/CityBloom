// The online relay (M30): `npx wrangler deploy -c relay/wrangler.jsonc` (the relay workflow does it
// from main). SQLite-backed Durable Objects, as the free plan requires.
{
  "name": "citybloom-relay",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "SIGNALS", "class_name": "SignalObject" },
      { "name": "REGIONS", "class_name": "RegionObject" },
      { "name": "REPORTS", "class_name": "ReportsObject" },
    ],
  },
  // Each new Durable Object class needs a migration of its own (phase 6 adds one per desk).
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RoomObject", "SignalObject", "RegionObject"] },
    { "tag": "v2", "new_sqlite_classes": ["ReportsObject"] },
  ],
  // OWNER_KEY is a secret (M41): set by the deploy workflow from the GitHub secret, never written here.
  "vars": { "ALLOWED_ORIGINS": "https://pxwom6.github.io" },
  // Logs keep what the code prints, never each request's details (its headers carry the caller's
  // address, which phase 6 doesn't keep beyond rate limits in the moment).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
