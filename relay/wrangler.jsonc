// The online relay (M30): `npx wrangler deploy -c relay/wrangler.jsonc` (the relay workflow does it
// from main). SQLite-backed Durable Objects, as the free plan requires.
{
  "name": "citybloom-relay",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "RoomObject" },
      { "name": "SIGNALS", "class_name": "SignalObject" },
      { "name": "REGIONS", "class_name": "RegionObject" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomObject", "SignalObject", "RegionObject"] }],
  "vars": { "ALLOWED_ORIGINS": "https://pxwom6.github.io" },
  "observability": { "enabled": true },
}
